# Copy to .env for local development. In production set these as environment variables on the host (Render etc.).
NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Local: the database started by ../db.  Production: your hosted database URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kangaroopost
# Only for a hosted database that requires SSL (external URLs usually do; Render internal URLs do not)
# PG_SSL=true

# REQUIRED in production: long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_local_dev_only

# REQUIRED in production: browser origins allowed to use the API (comma separated, no trailing slash)
# CORS_ORIGINS=https://your-site.netlify.app

# REQUIRED in production the first time: creates the first admin. Ignored once that admin exists. Password 10+ chars.
# ADMIN_EMAIL=admin@your-domain.com
# ADMIN_PASSWORD=
