# Copy this file to .env and fill in your key, then restart `npm run dev`.
# Google Maps JavaScript API key (Google Cloud Console -> APIs & Services -> Credentials).
# Restrict it to HTTP referrers (http://localhost:3000/* and your production domain) and to the Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: your own Map ID (Google Cloud Console -> Google Maps Platform -> Map Management).
# Leave empty to use Google's DEMO_MAP_ID while developing.
VITE_GOOGLE_MAPS_MAP_ID=
